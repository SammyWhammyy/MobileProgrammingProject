{
  "name": "campus-navigator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "mobile:mock": "npm run start:mock --workspace apps/mobile",
    "mobile:android": "npm run android --workspace apps/mobile",
    "server": "npm run start --workspace apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspace packages/map"
  }
}
